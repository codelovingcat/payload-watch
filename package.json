{
  "name": "payload-watch",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript-first library for detecting and explaining changes in JSON API payloads.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node scripts/benchmark.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:consumer": "node scripts/check-clean-consumer.mjs",
    "test:cli": "node --test tests/cli.integration.test.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release-preflight": "node --test tests/release-preflight.test.mjs",
    "check:release-candidate": "node scripts/check-release-candidate.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/",
    "bin/"
  ],
  "license": "MIT",
  "bin": {
    "payload-watch": "./bin/payload-watch.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelovingcat/payload-watch.git"
  },
  "homepage": "https://github.com/codelovingcat/payload-watch#readme",
  "bugs": {
    "url": "https://github.com/codelovingcat/payload-watch/issues"
  },
  "keywords": [
    "json",
    "api",
    "payload",
    "diff",
    "typescript",
    "cli"
  ]
}
